# Copiar a .env (que NO se sube a git) y completar.

# Dominio público (con su registro DNS A apuntando a la IP del servidor), sin https://
DOMINIO=nexus.tudominio.com

# Correos que son administradores (separados por coma). Se vuelven admin al registrarse o al ingresar.
NEXUS_ADMIN_EMAILS=tu-correo@gmail.com

# Ingreso con Google: Client ID público de Google Cloud (Credenciales → ID de cliente de OAuth → Aplicación web).
# Orígenes autorizados de JavaScript: https://<DOMINIO>. Vacío = sin botón de Google (solo correo y contraseña).
NEXUS_GOOGLE_CLIENT_ID=
