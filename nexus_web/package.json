{
  "name": "nexus-web",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS — interfaz del terminal de investigación (React + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "build:estatico": "VITE_ESTATICO=1 vite build --outDir dist-estatico --base ./",
    "grabar": "node scripts/grabar-instantanea.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.1.1",
    "lightweight-charts": "4.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
